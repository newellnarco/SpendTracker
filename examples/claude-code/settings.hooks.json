{
  "_comment": "Merge into ~/.claude/settings.json (user scope) so every project is tracked. `st hooks install` does this for you and shows a diff first.",
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://127.0.0.1:4318",
    "OTEL_RESOURCE_ATTRIBUTES": "spendtracker.node=CHANGE-ME"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.spendtracker/hooks/spendtracker-hook.sh",
            "args": [],
            "timeout": 5,
            "statusMessage": "SpendTracker: session start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.spendtracker/hooks/spendtracker-hook.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.spendtracker/hooks/spendtracker-hook.sh",
            "args": [],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${HOME}/.spendtracker/hooks/spendtracker-hook.sh",
            "args": [],
            "timeout": 10,
            "async": true
          }
        ]
      }
    ]
  }
}
